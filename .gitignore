# Security: never commit npm tokens / publish configs
.npmrc.publish.*
*.tmp

# Orqenix publish / fix / smoke scripts (sprint artifacts)
*.ps1
*.sh
*.cjs

# Sprint audit logs (already committed to docs/Delivery/Report)
d6p-*-audit.log
d6oss-*-audit.log
npm-publish-*-audit.log
packages/*/d6p-*-audit.log
packages/*/d6oss-*-audit.log
packages/*/npm-publish-*-audit.log

# Sprint prompt / runbook files (specs only, not code)
D6P-*prompt*
D6P-*runbook*

# Provenance and SBOM artifacts (generated by CI, not committed)
*.intoto.jsonl
*.sbom.json

