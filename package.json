{
  "name": "@orqenix-pro/root",
  "version": "0.5.0-phase-5",
  "private": true,
  "description": "Orqenix-Pro — Polyglot storage + LLM distillation + mesh delegation + blast-radius (BSL-1.1)",
  "license": "BUSL-1.1",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "verify-pro": "pnpm tsx scripts/gates/run-all-pro.ts",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "typecheck": "pnpm -r --filter=\"./packages/*\" typecheck",
    "pre-publish-check": "pnpm tsx scripts/pre-publish-check.ts",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && pnpm test && pnpm verify-pro && changeset publish",
    "ci:publish": "pnpm build && changeset publish",
    "release:dry-run": "pnpm -r exec npm pack --dry-run",
    "release:propose": "pnpm tsx scripts/release-propose.ts"
  },
  "workspaces": ["packages/*"],
  "devDependencies": {
    "@changesets/cli": "2.27.10",
