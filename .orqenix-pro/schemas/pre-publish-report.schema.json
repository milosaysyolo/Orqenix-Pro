{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orqenix.dev/schemas/pre-publish-report.schema.json",
  "title": "Orqenix Pre-Publish Report",
  "description": "Output schema for pre-publish-check.ts orchestrator",
  "type": "object",
  "required": ["timestamp", "mode", "totalChecks", "passed", "failed", "warned", "skipped", "durationMs", "blockingFailures", "results", "verdict"],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "mode": { "type": "string", "enum": ["oss", "pro"] },
    "repo": { "type": "string" },
    "totalChecks": { "type": "integer", "minimum": 0 },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "warned": { "type": "integer", "minimum": 0 },
    "skipped": { "type": "integer", "minimum": 0 },
    "durationMs": { "type": "integer", "minimum": 0 },
    "blockingFailures": { "type": "integer", "minimum": 0 },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "status", "durationMs", "message"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["blocking", "warning", "info"] },
          "status": { "type": "string", "enum": ["pass", "fail", "warn", "skip"] },
          "durationMs": { "type": "integer" },
          "message": { "type": "string" },
          "details": { "type": "object" }
        }
      }
    },
    "verdict": { "type": "string", "enum": ["go", "go-with-warnings", "no-go"] }
  }
}
