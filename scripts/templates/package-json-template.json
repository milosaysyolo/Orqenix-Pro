{
  "name": "@orqenix/<pkg-name>",
  "version": "0.5.0-phase-5",
  "description": "<one-line description from README>",
  "license": "Apache-2.0",
  "author": {
    "name": "Milo Nguyen",
    "email": "milo@orqenix.dev",
    "url": "https://orqenix.dev"
  },
  "homepage": "https://orqenix.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milosaysyolo/Orqenix.git",
    "directory": "packages/<pkg-name>"
  },
  "bugs": {
    "url": "https://github.com/milosaysyolo/Orqenix/issues"
  },
  "keywords": [
    "orqenix",
    "ai-agents",
    "<auto-from-pkg-domain>"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test"
  },
  "dependencies": {},
  "devDependencies": {},
  "peerDependencies": {},
  "sideEffects": false
}
